# Deliberately divergent oracle — NOT part of the committed passing corpus.
#
# Real Bitty divergence: mode ?47 switches the alternate buffer but does not
# save/restore the cursor. xterm's cursor is global across a buffer switch
# (charproc.c `srm_ALTBUF`: no CursorSave/CursorRestore, unlike 1049) and
# ghostty's SwitchScreenMode .@"47" "only copies the cursor" (it does not
# save/restore), so "X ?47h Y ?47l Z" in the reference leaves Z at column 2 ->
# row "X Z" and cursor column 3. Bitty's `switch_alt_screen` saves/restores
# the cursor for Via47 too, leaving "XZ" and cursor column 2. The expectation
# below records the reference behaviour the runner disagrees with.
area: alternate-screen
authority: ghostty-terminal
cite: /// Legacy alternate screen mode. This goes to the alternate
grid: 80x24
grid_text: unchecked
row 0: X Z
cursor: 0 3 visible
