#!/usr/bin/env bash
# PB-1 cold startup — real-window instrumentation (CTX-0100).
# Budget: ≤100 ms p50 / ≤200 ms p99 first prompt frame (performance-budget-rfc.md#pb-1)
# Scope: CTX-0100 upgrade from `--help` proxy to real-window tracing:
#   process start → args → config → runtime (font+surface) → layout → PTY spawn
#   → winit window probe → wgpu init probe → font probe → first shell bytes
#   → first frame presented. Each phase timestamped with Instant, bounded,
#   headless or real window. On headless CI winit/wgpu report Unavailable with
#   attempt duration; on Tier 1 with BITTY_PERF_REAL_WINDOW=1 they report real.
#   Former --help/hyperfine path retained as secondary comparison.
#
# Bounded: 1 startup_real bench run + 50 hyperfine samples max, timeout guarded.
# Headless: never requires window to prove seam; real gated on display.

set -euo pipefail

PB1_P50_MS=100
PB1_P99_MS=200
TIMEOUT_SECS="${PERF_TIMEOUT_SECS:-30}"

goto_root() {
	cd "$(dirname "${0}")/../.."
}

have_cargo() {
	command -v cargo >/dev/null 2>&1
}

main() {
	goto_root
	echo "perf/startup — PB-1 cold startup ≤${PB1_P50_MS} ms p50 / ≤${PB1_P99_MS} ms p99 (CTX-0100 real-window tracing, bounded)"
	echo "budget: bitty-docs/docs/specifications/performance-budget-rfc.md#pb-1 (default config, warm file cache, local shell)"
	echo "pipeline: process_start → args_parse → config_load → runtime_create(font+surface) → layout → pty_spawn → winit_probe → wgpu_probe → font_probe → first_bytes → first_frame"
	echo "instrumentation: crates/bitty-perf/src/startup.rs Instant per-phase, benches/startup_real.rs (headless baseline, BITTY_PERF_REAL_WINDOW=1 for real)"

	if ! have_cargo; then
		echo "skip: cargo not on PATH"
		exit 0
	fi

	echo "--- benches/startup_real.rs (CTX-0100 real-window instrumentation, timeout ${TIMEOUT_SECS}s) ---"
	if timeout "${TIMEOUT_SECS}" cargo bench -p bitty-perf --bench startup_real -- --nocapture 2>&1 | tail -n 120; then
		echo "startup_real bench: ran headless baseline (winit/wgpu phases show ok or unavailable with duration)"
	else
		echo "startup_real bench: timeout or compile error — fallback to cargo bench --no-run check"
		cargo bench --no-run 2>&1 | tail -n 20 || true
	fi

	# Secondary: hyperfine comparison when available (retains Phase F history).
	if command -v hyperfine >/dev/null 2>&1; then
		echo "--- hyperfine comparison (secondary, --help path retained for history, not primary) ---"
		echo "runner: hyperfine 5 runs, timeout ${TIMEOUT_SECS}s"
		bin="./target/release/bitty-app"
		if [ ! -x "${bin}" ]; then
			cargo build --release -p bitty-app >/dev/null 2>&1 || true
		fi
		if [ -x "${bin}" ]; then
			hyperfine --warmup 1 --runs 5 --export-json "/tmp/bitty-perf-startup.json" "${bin} --help" 2>&1 | tail -n 20 || true
			echo "hyperfine JSON: /tmp/bitty-perf-startup.json (headless --help proxy, not real first-frame)"
		fi
	else
		echo "hyperfine not present — primary instrumentation is startup_real bench above"
	fi

	echo "PB-1 real-window tracing done (primary: startup_real Instant per-phase; headless CI shows unavailable with duration, Tier 1 real shows success; see docs/product/perf-evidence.md and crates/bitty-perf/src/startup.rs)"
}

main "$@"
