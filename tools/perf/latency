#!/usr/bin/env bash
# PB-4 input latency — real-window tracing (CTX-0100).
# Budget: ≤8 ms p50 / ≤15 ms p99 key-to-screen (performance-budget-rfc.md#pb-4, 60 Hz, Wayland)
# Scope: CTX-0100 upgrade from headless proxy to real pipeline tracing:
#   keydown → encode_key_event (≤64 B) → Runtime::handle_key_event → PTY → parser
#   → State → Damage → GridRenderer (fake or crossfont) → Surface::present
#   with Instant per-stage and p50/p99/mean/max over 1_000 samples, bounded
#   (≤8 KiB corpus, ≤256 damage regions). Headless uses headless_present;
#   real Wayland photon timestamp is future slice without API change.
#
# Bounded: 1 latency_real bench (1_000 samples) + fallback benches, timeout guarded.

set -euo pipefail

PB4_P50_MS=8
PB4_P99_MS=15
TIMEOUT_SECS="${PERF_TIMEOUT_SECS:-30}"

goto_root() {
	cd "$(dirname "${0}")/../.."
}

have_cargo() {
	command -v cargo >/dev/null 2>&1
}

main() {
	goto_root
	echo "perf/latency — PB-4 ≤${PB4_P50_MS} ms p50 / ≤${PB4_P99_MS} ms p99 key-to-screen (CTX-0100 real-window tracing, bounded)"
	echo "budget: bitty-docs/docs/specifications/performance-budget-rfc.md#pb-4 (60 Hz minimum, Wayland/frame-presented, plugins off hot path)"
	echo "pipeline: keydown → encode(≤64 B) → handle_key → PTY→parser→State → Damage → GridRenderer → Surface::present"
	echo "instrumentation: crates/bitty-perf/src/latency.rs Instant per-stage, p50/p99 over presented samples, benches/latency_real.rs"

	if ! have_cargo; then
		echo "skip: cargo not on PATH"
		exit 0
	fi

	echo "check: cargo bench --no-run (bounded compile, no display)"
	if cargo bench --no-run 2>&1 | tail -n 20; then
		echo "bench compile: PASS (headless, bounded)"
	else
		echo "bench compile: FAIL — see above"
	fi

	echo "--- benches/latency_real.rs (CTX-0100 keydown→present, timeout ${TIMEOUT_SECS}s) ---"
	if timeout "${TIMEOUT_SECS}" cargo bench -p bitty-perf --bench latency_real -- --nocapture 2>&1 | tail -n 120; then
		echo "latency_real bench: ran headless echo model (presented p50/p99 over 1_000 samples)"
	else
		echo "latency_real bench: timeout or error — fallback to terminal_state/render_prepare"
		for b in terminal_state render_prepare; do
			echo "--- cargo bench --bench ${b} (timeout ${TIMEOUT_SECS}s) ---"
			timeout "${TIMEOUT_SECS}" cargo bench -p bitty-perf --bench "${b}" -- --nocapture 2>&1 | tail -n 40 || true
		done
	fi

	echo "PB-4 tracing done (primary: latency_real per-stage Instant + p50/p99; headless CI via headless_present, real via wgpu when attached; see docs/product/perf-evidence.md and crates/bitty-perf/src/latency.rs)"
}

main "$@"
