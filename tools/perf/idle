#!/usr/bin/env bash
# PB-7 idle resource — real-window invariant (CTX-0100).
# Budget: ≤1% avg CPU over 10 min, zero periodic wakeups when idle
#         (no PTY output, animation, or plugin timer → frame-on-demand)
#         (performance-budget-rfc.md#pb-7)
# Scope: CTX-0100 upgrade: proves frame-on-demand invariant via
#   Runtime::tick returns None when no new generation and no pending_full_redraw
#   → ControlFlow::Wait → zero wakeups. Checks GridRenderer FrameMode::Clean,
#   idle tick mean, clean render mean, and bounded ps %cpu sample. Real 10 min
#   ≤1% gated on Tier 1 ref machine; headless CI shows 0 idle ticks + Clean.
#
# Bounded: 1 idle_real bench (9 checks + 5k ticks) + ps sample, timeout guarded.

set -euo pipefail

PB7_PCT=1
TIMEOUT_SECS="${PERF_TIMEOUT_SECS:-20}"

goto_root() {
	cd "$(dirname "${0}")/../.."
}

have_cargo() {
	command -v cargo >/dev/null 2>&1
}

main() {
	goto_root
	echo "perf/idle — PB-7 ≤${PB7_PCT}% CPU avg over 10 min, zero wakeups when idle (CTX-0100 frame-on-demand, bounded)"
	echo "budget: bitty-docs/docs/specifications/performance-budget-rfc.md#pb-7 (no PTY output/animation/plugin timer → Wait loop)"
	echo "invariant: tick == None when no damage and no pending_full_redraw → Wait → zero periodic wakeups"
	echo "instrumentation: crates/bitty-perf/src/idle.rs 9 checks + idle_tick_mean + clean_render_mean, benches/idle_real.rs"

	if have_cargo; then
		echo "--- benches/idle_real.rs (CTX-0100 frame-on-demand, timeout ${TIMEOUT_SECS}s) ---"
		if timeout "${TIMEOUT_SECS}" cargo bench -p bitty-perf --bench idle_real -- --nocapture 2>&1 | tail -n 120; then
			echo "idle_real bench: frame-on-demand PASS (tick None when idle, Clean when no damage)"
		else
			echo "idle_real bench: timeout or error — fallback to render_prepare clean check"
			timeout "${TIMEOUT_SECS}" cargo bench -p bitty-perf --bench render_prepare -- --nocapture 2>&1 | grep -E "clean|PB-7|needs_draw|FrameMode|PASS" | head -n 20 || true
		fi
	else
		echo "skip cargo render check: cargo not on PATH"
	fi

	# Bounded CPU sample: sleep child should be ~0% (proxy, real 10 min on Tier 1).
	echo "cpu sample: 1s sleep child %cpu (proxy, real 10 min ≤1% on Tier 1 ref machine)"
	sleep 1 &
	sleep_pid=$!
	sleep 0.2
	mid_cpu="$(ps -o %cpu= -p "${sleep_pid}" 2>/dev/null | tr -d ' ' || echo "0.0")"
	echo "  idle child sleep pid ${sleep_pid} %cpu mid: ${mid_cpu}% (expect ~0.0, PB-7 ≤${PB7_PCT}%)"
	wait "${sleep_pid}" 2>/dev/null || true
	if awk -v cpu="${mid_cpu}" -v b="${PB7_PCT}" 'BEGIN { exit !(cpu > b) }'; then
		echo "warn: sample ${mid_cpu}% > PB-7 ${PB7_PCT}% — sampling noise (sleep child should be ~0)"
	else
		echo "PB-7 proxy PASS: ${mid_cpu}% ≤ ${PB7_PCT}% (sleep child; product idle gated on Tier 1)"
	fi

	echo "PB-7 real-window invariant done (zero wakeups == every idle tick None → Wait; clean Damage→Clean→no draws; see docs/product/perf-evidence.md and crates/bitty-perf/src/idle.rs)"
}

main "$@"
